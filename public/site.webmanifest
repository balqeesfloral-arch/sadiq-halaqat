{
  "id": "/",
  "name": "الصديق",
  "short_name": "الصديق",
  "description": "منظومة احترافية لإدارة حلقات تحفيظ القرآن الكريم ومتابعة الحضور والتسميع والإنجاز والعناية بالطالب.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#F7F4EA",
  "theme_color": "#0F4C45",
  "lang": "ar",
  "dir": "rtl",
  "categories": [
    "education",
    "productivity"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "تسجيل الدخول",
      "short_name": "الدخول",
      "description": "فتح صفحة تسجيل الدخول إلى الصديق",
      "url": "/login?source=shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "إشعارات الطالب",
      "short_name": "الإشعارات",
      "description": "فتح مركز إشعارات الطالب",
      "url": "/student/notifications?source=shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
