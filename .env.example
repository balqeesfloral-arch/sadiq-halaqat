# Frontend-only public configuration. Never place service_role / secret keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Public Web Push VAPID key. Safe to expose to the browser.
# Generate the pair locally; keep VAPID_PRIVATE_KEY only in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
